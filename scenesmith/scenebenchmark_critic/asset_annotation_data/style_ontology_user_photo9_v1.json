{"schema_version":"style_ontology@user_photo9.1","protocol":"style9_palette_material@20261105.1","status":"formal_user_authorized_20261112","multilabel":true,"grouping_fields":false,"level_1":[{"id":"modern","name_zh":"现代风格","level_2_ids":["simple","monochrome_neutral","minimalist","cream","light_luxury"]},{"id":"chinese","name_zh":"中式风格","level_2_ids":["traditional_chinese","new_chinese","song_chinese"]},{"id":"european","name_zh":"欧式风格","level_2_ids":["simplified_european","nordic","country","midcentury_reference"]},{"id":"american","name_zh":"美式风格","level_2_ids":["american_country","retro","simple","light_luxury","midcentury_reference"]},{"id":"japanese","name_zh":"日式风格","level_2_ids":["traditional_japanese","natural_wood","wabi_sabi"]},{"id":"french","name_zh":"法式风格","level_2_ids":["light_french","cream","country","retro"]},{"id":"mediterranean","name_zh":"地中海风格","level_2_ids":["blue_white","ochre_brown"]},{"id":"southeast_asian","name_zh":"东南亚风格","level_2_ids":["traditional_southeast_asian","nanyang_retro"]},{"id":"eclectic","name_zh":"混搭风格","level_2_ids":[]}],"level_2":[{"id":"simple","name_zh":"简约","definition":"形式简化、线条清楚、装饰克制；结合所属一级的设计语汇。","allowed_parents":["modern","american"]},{"id":"monochrome_neutral","name_zh":"黑白灰","definition":"现代设计语言中的黑白灰取向；实际配色另外记录。","allowed_parents":["modern"]},{"id":"minimalist","name_zh":"极简","definition":"以形式删减、比例和细部收束组织整体。","allowed_parents":["modern"]},{"id":"cream","name_zh":"奶油","definition":"柔和体块、表面与温和浅色配合形成的家装取向；单一米白色不足以判风格。","allowed_parents":["modern","french"]},{"id":"light_luxury","name_zh":"轻奢","definition":"克制轮廓与精细饰面、装饰细节协调的取向；金色本身不是充分依据。","allowed_parents":["modern","american"]},{"id":"traditional_chinese","name_zh":"传统中式","definition":"有中国传统器型、构件、比例或装饰依据；明清原词继续保留。","allowed_parents":["chinese"]},{"id":"new_chinese","name_zh":"新中式","definition":"中国传统形式在现代家具中的具体转译。","allowed_parents":["chinese"]},{"id":"song_chinese","name_zh":"宋代中式","definition":"有出处的宋代家具器型或相应设计参考，记录具体形式依据。","allowed_parents":["chinese"]},{"id":"s