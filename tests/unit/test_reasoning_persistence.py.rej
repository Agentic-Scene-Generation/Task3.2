--- tests/unit/test_reasoning_persistence.py
+++ tests/unit/test_reasoning_persistence.py
@@ -64,5 +64,54 @@ def _table_count(db_path, table: str) -> int:
 
 def teardown_function():
     configure_reasoning_persistence(enabled=False, provider="disabled")
 
+def _status_error(status_code: int) -> RuntimeError:
+    error = RuntimeError(f"HTTP {status_code}")
+    error.status_code = status_code
+    return error
+
+
+def test_sync_transient_statuses_use_configured_retry_delays(monkeypatch):
+    response = _chat_response()
+    raw_client = _sync_client(response)
+    raw_client.responses.create.side_effect = [
+        _status_error(502),
+        _status_error(503),
+        _status_error(524),
+        response,
+    ]
+    sleep = Mock()
+    monkeypatch.setenv(
+        "SCENEEXPERT_OPENAI_TRANSIENT_RETRY_DELAYS",
+        "30,60,120",
+    )
+    monkeypatch.setattr(openai_utils.time, "sleep", sleep)
+
+    result = ReasoningPersistenceOpenAIClient(
+        client=raw_client
+    ).responses.create(model="gpt-5.5", input="hello")
+
+    assert result is response
+    assert raw_client.responses.create.call_count == 4
+    assert [entry.args[0] for entry in sleep.call_args_list] == [30.0, 60.0, 120.0]
+
+
+def test_async_transient_status_uses_configured_retry_delay(monkeypatch):
+    response = _chat_response()
+    raw_client = _async_client(response)
+    raw_client.chat.completions.create.side_effect = [
+        _status_error(503),
+        response,
+    ]
+    sleep = AsyncMock()
+    monkeypatch.setenv(
+        "SCENEEXPERT_OPENAI_TRANSIENT_RETRY_DELAYS",
+        "30",
+    )
+    monkeypatch.setattr(openai_utils.asyncio, "sleep", sleep)
+    client = ReasoningPersistenceAsyncOpenAIClient(client=raw_client)
+
+    assert asyncio.run(client.chat.completions.create(model="gpt-5.5")) is response
+    sleep.assert_awaited_once_with(30.0)
+
 
